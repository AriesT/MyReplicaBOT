# Токен від @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Адреса ComfyUI (за замовчуванням localhost)
COMFY_URL=http://127.0.0.1:8188

# Назва файлу checkpoint (точна назва з папки models/checkpoints у ComfyUI)
CHECKPOINT=v1-5-pruned-emaonly.ckpt

# Параметри генерації
IMAGE_WIDTH=512
IMAGE_HEIGHT=512
STEPS=20
CFG_SCALE=7.0
NEGATIVE_PROMPT=ugly, blurry, low quality, watermark, text, deformed, extra limbs

# MMORPG Game API (optional — leave empty to disable)
GAME_API_URL=https://your-game-server.com
GAME_API_KEY=rok_235854...

